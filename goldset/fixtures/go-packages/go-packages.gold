# A package-level function is visible in every file of its package, without an import.
def shape.go:12:21 -> math.go:3:6
strong shape.go:12:21
# An in-package test file is the same package.
def shape_test.go:6:5 -> math.go:3:6
# An external `_test` package is another package with its own `pi`.
def shape_ext_test.go:12:23 -> shape_ext_test.go:9:6
callers math.go:3:6 == shape.go:12:21,shape_test.go:6:5
# Build-tag variants both answer (each `.probable`, checked in GoResolutionTests).
def5 math.go:8:9 -> platform_linux.go:3:6
def5 math.go:8:9 -> platform_darwin.go:3:6
# `pkg.F` resolves inside the package the import path names.
def shape_ext_test.go:12:13 -> shape.go:15:6
